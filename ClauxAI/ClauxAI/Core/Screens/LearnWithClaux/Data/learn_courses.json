      "detail": {
        "tabs": [
          {
            "id": "overview",
            "title": "Overview",
            "sections": [
              {
                "id": "intro",
                "kind": "heading",
                "title": "Introduction:",
                "text": "HTML, short for HyperText Markup Language, is the standard markup language used to create and structure content on the web. It serves as the backbone of every webpage by defining elements such as headings, paragraphs, links, images, and forms.",
                "items": null
              },
              {
                "id": "what-is",
                "kind": "heading",
                "title": "What is HTML",
                "text": "HTML is not a programming language, but a markup language that tells browsers how to display content. Each piece of content is wrapped in tags that describe its purpose.",
                "items": null
              },
              {
                "id": "purpose",
                "kind": "heading",
                "title": "Purpose of HTML",
                "text": "The primary goal of HTML is to structure content meaningfully so users and search engines understand what each section represents.",
                "items": null
              },
              {
                "id": "core-concepts",
                "kind": "heading",
                "title": "Core Concepts of HTML",
                "text": null,
                "items": [
                  { "term": "Elements", "definition": "Building blocks of HTML pages" },
                  { "term": "Tags", "definition": "Keywords enclosed in angle brackets" },
                  { "term": "Attributes", "definition": "Extra information about elements" },
                  { "term": "Structure", "definition": "Hierarchy of page layout" },
                  { "term": "Semantic meaning", "definition": "Describes purpose of content" }
                ]
              },
              {
                "id": "structure-guidelines",
                "kind": "heading",
                "title": "HTML Document Structure Guidelines",
                "text": "Every HTML document begins with a root <html> element. Inside it, two main sections exist: <head> for metadata and <body> for visible content.",
                "items": null
              },
              {
                "id": "head-guidelines",
                "kind": "heading",
                "title": "Head Section Guidelines",
                "text": "The <head> section usually contains title tags, meta descriptions, charset settings, and links to CSS/JS files. Metadata here is essential for browser behavior and SEO optimization.",
                "items": null
              }
            ]
          },
          {
            "id": "examples",
            "title": "Examples",
            "sections": [
              {
                "id": "examples-intro",
                "kind": "paragraph",
                "title": null,
                "text": "Explore practical HTML examples including semantic layouts, forms, media embedding, and accessible navigation patterns.",
                "items": null
              }
            ]
          },
          {
            "id": "assignments",
            "title": "Assignments",
            "sections": [
              {
                "id": "assignments-intro",
                "kind": "paragraph",
                "title": null,
                "text": "Build a personal portfolio page, a product landing section, and a contact form using semantic HTML tags.",
                "items": null
              }
            ]
          },
          {
            "id": "career",
